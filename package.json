{
  "name": "liveoakv3",
  "private": true,
  "workspaces": [
    "packages/*",
    "functions",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck:edge-functions": "cd supabase/functions && deno check _shared/*.ts ping/index.ts scheduled-ping/index.ts resolveMyAccess/*.ts",
    "test:edge-functions": "cd supabase/functions && deno test --allow-env --allow-net _shared/ resolveMyAccess/"
  },
  "devDependencies": {
    "supabase": "^2.114.0",
    "typescript": "^5.6.3"
  }
}
