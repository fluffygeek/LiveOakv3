{
  "expo": {
    "name": "LiveOakv3",
    "slug": "liveoakv3",
    "scheme": "liveoakv3",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.liveoakv3.mobile"
    },
    "android": {
      "package": "com.liveoakv3.mobile"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "LiveOakv3 needs photo library access so Technicians can attach job photos.",
          "cameraPermission": "LiveOakv3 needs camera access so Technicians can photograph completed work."
        }
      ]
    ]
  }
}
